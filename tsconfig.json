{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "noImplicitReturns": true,
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["src/lib/*"],
      "$core/*": ["src/core/*"],
      "$features/*": ["src/features/*"],
      "$shared/*": ["src/shared/*"],
      "$app/*": ["src/app/*"]
    }
  }
}
